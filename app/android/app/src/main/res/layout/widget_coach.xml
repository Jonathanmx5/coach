<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_racine"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_fond"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="8dp">

    <FrameLayout
        android:layout_width="104dp"
        android:layout_height="match_parent">

        <ImageView
            android:id="@+id/widget_anneaux"
            android:layout_width="90dp"
            android:layout_height="90dp"
            android:layout_gravity="center"
            android:contentDescription="@string/widget_anneaux_description"
            android:scaleType="fitCenter" />

        <ImageButton
            android:id="@+id/widget_photo"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:layout_gravity="top|start"
            android:background="@drawable/widget_photo"
            android:contentDescription="@string/widget_photo_description"
            android:padding="8dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_camera" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        android:layout_marginEnd="8dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/widget_titre_eau"
            android:textColor="#45453F"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/widget_eau"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:text="—"
            android:textColor="#2F6FB8"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_bilan"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:textColor="#2C2C2A"
            android:textSize="12sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="96dp"
        android:layout_height="match_parent"
        android:orientation="vertical">

            <Button
                android:id="@+id/widget_plus1000"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginBottom="3dp"
                android:layout_weight="1"
                android:background="@drawable/widget_bouton"
                android:contentDescription="@string/widget_ajouter_1000"
                android:padding="0dp"
                android:minHeight="0dp"
                android:minWidth="0dp"
                android:text="+ 1 L"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="12sp" />
            <Button
                android:id="@+id/widget_plus500"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginBottom="3dp"
                android:layout_weight="1"
                android:background="@drawable/widget_bouton"
                android:contentDescription="@string/widget_ajouter_500"
                android:padding="0dp"
                android:minHeight="0dp"
                android:minWidth="0dp"
                android:text="+500 ml"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="12sp" />
            <Button
                android:id="@+id/widget_plus250"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginBottom="3dp"
                android:layout_weight="1"
                android:background="@drawable/widget_bouton"
                android:contentDescription="@string/widget_ajouter_250"
                android:padding="0dp"
                android:minHeight="0dp"
                android:minWidth="0dp"
                android:text="+250 ml"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="12sp" />
            <Button
                android:id="@+id/widget_plus180"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginBottom="3dp"
                android:layout_weight="1"
                android:background="@drawable/widget_bouton"
                android:contentDescription="@string/widget_ajouter_180"
                android:drawableStart="@drawable/ic_verre"
                android:drawablePadding="4dp"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:minHeight="0dp"
                android:minWidth="0dp"
                android:text="18 cl"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="12sp" />
    </LinearLayout>
</LinearLayout>
