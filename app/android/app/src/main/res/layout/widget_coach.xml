<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_racine"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_fond"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="12dp">

    <ImageView
        android:id="@+id/widget_anneaux"
        android:layout_width="96dp"
        android:layout_height="96dp"
        android:contentDescription="@string/widget_anneaux_description"
        android:scaleType="fitCenter" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/widget_titre_eau"
            android:textColor="#5F5E5A"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/widget_eau"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="—"
            android:textColor="#2F6FB8"
            android:textSize="19sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_bilan"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#2C2C2A"
            android:textSize="12sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/widget_plus250"
                android:contentDescription="@string/widget_ajouter_250"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:background="@drawable/widget_bouton"
                android:minHeight="0dp"
                android:minWidth="0dp"
                android:padding="0dp"
                android:text="+250 ml"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="13sp" />

            <Button
                android:id="@+id/widget_plus500"
                android:contentDescription="@string/widget_ajouter_500"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:background="@drawable/widget_bouton"
                android:minHeight="0dp"
                android:minWidth="0dp"
                android:padding="0dp"
                android:text="+500 ml"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
