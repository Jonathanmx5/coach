<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_racine"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_fond"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="8dp">

    <!-- Trois colonnes en largeurs proportionnelles : le widget tient en 4
         colonnes de l'écran d'accueil, même sur les anciens lanceurs. Celles
         de gauche et de droite ont le même poids, pour que la roue reste au
         centre du widget. -->

    <!-- Colonne de gauche : appareil photo en haut, eau et bilan en bas. -->
    <FrameLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1">

        <ImageButton
            android:id="@+id/widget_photo"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="top|start"
            android:background="@drawable/widget_photo"
            android:contentDescription="@string/widget_photo_description"
            android:padding="11dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_camera" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|start"
            android:orientation="vertical"
            android:paddingStart="2dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/widget_titre_eau"
                android:textColor="#45453F"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/widget_eau"
                android:layout_width="match_parent"
                android:layout_height="20dp"
                android:autoSizeMaxTextSize="15sp"
                android:autoSizeMinTextSize="9sp"
                android:autoSizeTextType="uniform"
                android:maxLines="1"
                android:text="—"
                android:textColor="#2F6FB8"
                android:textSize="15sp"
                android:textStyle="bold" />

            <!-- L'eau en barre native : les boutons d'eau la tiennent à jour
                 sans que l'appli redessine l'image des anneaux. -->
            <ProgressBar
                android:id="@+id/widget_eau_barre"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="4dp"
                android:layout_marginTop="2dp"
                android:layout_marginBottom="2dp"
                android:max="2000"
                android:progress="0"
                android:progressTint="#378ADD" />

            <TextView
                android:id="@+id/widget_bilan"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="2"
                android:textColor="#2C2C2A"
                android:textSize="11sp" />
        </LinearLayout>
    </FrameLayout>

    <!-- Au milieu : la roue (calories brûlées, mangées, protéines), centrée
         en largeur et en hauteur. -->
    <FrameLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_marginStart="4dp"
        android:layout_marginEnd="4dp"
        android:layout_weight="0.8">

        <ImageView
            android:id="@+id/widget_anneaux"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_gravity="center"
            android:contentDescription="@string/widget_anneaux_description"
            android:scaleType="fitCenter" />
    </FrameLayout>

    <!-- À droite : les quatre boutons d'eau en grille 2 × 2, pour des zones
         tactiles aussi grandes que la place le permet. -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginBottom="3dp"
            android:layout_weight="1"
            android:orientation="horizontal">

            <Button
                android:id="@+id/widget_plus1000"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginEnd="3dp"
                android:layout_weight="1"
                android:autoSizeMaxTextSize="13sp"
                android:autoSizeMinTextSize="8sp"
                android:autoSizeTextType="uniform"
                android:background="@drawable/widget_bouton"
                android:contentDescription="@string/widget_ajouter_1000"
                android:maxLines="1"
                android:minHeight="0dp"
                android:minWidth="0dp"
                android:padding="2dp"
                android:text="+ 1 L"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="13sp" />

            <Button
                android:id="@+id/widget_plus500"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:autoSizeMaxTextSize="13sp"
                android:autoSizeMinTextSize="8sp"
                android:autoSizeTextType="uniform"
                android:background="@drawable/widget_bouton"
                android:contentDescription="@string/widget_ajouter_500"
                android:maxLines="1"
                android:minHeight="0dp"
                android:minWidth="0dp"
                android:padding="2dp"
                android:text="+500 ml"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="13sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">

            <Button
                android:id="@+id/widget_plus250"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginEnd="3dp"
                android:layout_weight="1"
                android:autoSizeMaxTextSize="13sp"
                android:autoSizeMinTextSize="8sp"
                android:autoSizeTextType="uniform"
                android:background="@drawable/widget_bouton"
                android:contentDescription="@string/widget_ajouter_250"
                android:maxLines="1"
                android:minHeight="0dp"
                android:minWidth="0dp"
                android:padding="2dp"
                android:text="+250 ml"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="13sp" />

            <Button
                android:id="@+id/widget_plus180"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:autoSizeMaxTextSize="13sp"
                android:autoSizeMinTextSize="8sp"
                android:autoSizeTextType="uniform"
                android:background="@drawable/widget_bouton"
                android:contentDescription="@string/widget_ajouter_180"
                android:drawableStart="@drawable/ic_verre"
                android:drawablePadding="2dp"
                android:maxLines="1"
                android:minHeight="0dp"
                android:minWidth="0dp"
                android:paddingStart="6dp"
                android:paddingEnd="4dp"
                android:text="18 cl"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
